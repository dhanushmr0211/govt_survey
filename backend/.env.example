NODE_ENV=development
PORT=3000
# Cloud SQL config: use the instance connection name and the database credentials below.
CLOUD_SQL_CONNECTION_NAME=your-project:region:instance-name
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_NAME=govt_survey

# Optional fallback for local/dev connections that do not use Cloud SQL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DB_SSL=true
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-private-bucket-name
GCS_SIGNED_URL_EXPIRATION_SECONDS=900
